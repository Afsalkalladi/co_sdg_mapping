# Copy this file to .env.local and fill in the values from
# Supabase → Settings → API Keys (use the Publishable key, never the Secret key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Show the "Continue with Google" button (set up the Google provider in Supabase first).
NEXT_PUBLIC_GOOGLE_AUTH=false

# ── AI for automatic WK/SDG mapping ──
# Any OpenAI-compatible provider works. Default: Google Gemini (free key at https://aistudio.google.com/apikey)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
# How much the model "thinks" before answering (Gemini default here: low). Use none if answers are slow.
# AI_REASONING_EFFORT=low
# Groq instead (free key at https://console.groq.com/keys):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
# OpenRouter instead (https://openrouter.ai/keys):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=<any model id; ids ending in :free cost nothing>
